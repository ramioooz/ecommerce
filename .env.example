# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKER=kafka:9092

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URLs (for each service)
DATABASE_URL_USERS=postgresql://postgres:postgres@postgres-users:5432/users
DATABASE_URL_PRODUCTS=postgresql://postgres:postgres@postgres-products:5432/products
DATABASE_URL_ORDERS=postgresql://postgres:postgres@postgres-orders:5432/orders
DATABASE_URL_PAYMENTS=postgresql://postgres:postgres@postgres-payments:5432/payments

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx

# Email (SMTP)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ecommerce

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
